# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
# Configure this via your hosting platform's environment variables.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links and redirects.
APP_URL="https://your-domain.vercel.app"

# SUPABASE CONFIGURATION
# Add these to your hosting platform (Vercel, Netlify, etc.).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
